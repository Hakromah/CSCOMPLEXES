{
  "kind": "collectionType",
  "collectionName": "timetable_entries",
  "info": {
    "singularName": "timetable-entry",
    "pluralName": "timetable-entries",
    "displayName": "Timetable Entry"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "dayOfWeek": {
      "type": "enumeration",
      "enum": [
        "MONDAY",
        "TUESDAY",
        "WEDNESDAY",
        "THURSDAY",
        "FRIDAY",
        "SATURDAY",
        "SUNDAY"
      ],
      "required": true
    },
    "startTime": {
      "type": "time",
      "required": true
    },
    "endTime": {
      "type": "time",
      "required": true
    },
    "periodName": {
      "type": "string"
    },
    "lessonType": {
      "type": "enumeration",
      "enum": [
        "REGULAR",
        "PRACTICAL",
        "LAB",
        "TUTORIAL",
        "BREAK",
        "LUNCH",
        "ASSEMBLY",
        "EXAM",
        "STUDY",
        "SPORTS",
        "OTHER"
      ],
      "default": "REGULAR"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "ARCHIVED"
      ],
      "default": "PUBLISHED"
    },
    "roomName": {
      "type": "string"
    },
    "notes": {
      "type": "text"
    },
    "classe": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::school-class.school-class"
    },
    "subject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subject.subject"
    },
    "teacher": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "room": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::school-room.school-room"
    },
    "academicYear": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::academic-year.academic-year"
    },
    "semester": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::semester.semester"
    }
  }
}